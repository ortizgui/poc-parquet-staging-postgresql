# =============================================================================
# .env.example — template de configuracao local (pt-BR)
# =============================================================================
#
# COMO USAR:
#     cp .env.example .env
#
# AVISOS IMPORTANTES:
#   - Estes valores sao PLACEHOLDERS LOCAIS para o emulador AWS (ministack) e o
#     PostgreSQL do docker compose. NAO sao credenciais reais.
#   - NUNCA coloque credenciais reais neste arquivo. O `.env` e gitignored, mas
#     um segredo que entra no disco pode vazar por backup, log ou `git add -f`.
#   - Em AWS/ECS as credenciais vem da TASK ROLE (IAM), NUNCA de arquivo nem de
#     variavel com chave estatica. Este `.env` serve so para o ambiente local.
#   - Variaveis sem valor explicito no `.env` caem nos defaults do
#     `docker-compose.yml` (knobs do consumer) ou nos defaults dos scripts.
#
# =============================================================================


# -----------------------------------------------------------------------------
# S3 / SQS emulado (ministack na porta 4566)
# -----------------------------------------------------------------------------
# Credenciais fake exigidas pelo SDK/boto3 — o ministack aceita qualquer valor.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566

# Bucket onde o gerador sobe os parquets e de onde o worker le.
S3_BUCKET=poc-bucket


# -----------------------------------------------------------------------------
# Filas / Topicos
# -----------------------------------------------------------------------------
# ATENCAO — dois nomes para as mesmas filas, de proposito:
#   - `setup_infra.py` le SQS_NOTIFICATION_QUEUE / SQS_NOTIFICATION_DLQ
#     (defina estas para criar as filas com o nome desejado).
#   - O A/B runner (`run_memory_test.sh`, `test_rowgroup_ab.sh`) le SQS_QUEUE /
#     SQS_DLQ, com defaults `poc-notification-queue` / `poc-notification-dlq`.
#     Descomente as linhas opcionais abaixo para apontar o runner para outros
#     nomes. Se os nomes coincidem, nao e preciso definir.
SQS_NOTIFICATION_QUEUE=poc-notification-queue
SQS_NOTIFICATION_DLQ=poc-notification-dlq

# Opcionais — leitura pelo A/B runner (run_memory_test.sh, test_rowgroup_ab.sh)
# SQS_QUEUE=poc-notification-queue
# SQS_DLQ=poc-notification-dlq

# Topico SNS opcional (usado com `--sns` no setup_infra.py ou no
# simulate_s3_notification.py). O fluxo de producao e S3 -> SQS direto.
SNS_TOPIC_NAME=poc-notification-topic


# -----------------------------------------------------------------------------
# PostgreSQL (container do docker compose)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pocdb
POSTGRES_USER=pocuser
POSTGRES_PASSWORD=pocpass


# -----------------------------------------------------------------------------
# Knobs do consumer / compose
# -----------------------------------------------------------------------------
# Lidas pelo `docker compose` para substituir ${CONSUMER_*} no docker-compose.yml.
# Todas tem default no compose — so descomente para sobrescrever.

# Limite de memoria do pod (eixo do teste de paginacao). Default: 512m
# Exemplos: 128m (ainda passa), 80m (falha por memoria), 1g (comparativo).
# CONSUMER_MEM_LIMIT=512m

# Modo de leitura do Parquet no S3. Default: S3Range
#   S3Range   -> le o footer e busca so os bytes necessarios (sem disco)
#   LocalFile -> baixa o objeto para arquivo temporario
# CONSUMER_READ_MODE=S3Range

# Envia If-Match com o ETag em toda requisicao Range. Default: true
# CONSUMER_PIN_OBJECT_VERSION=true

# Loga cada Range GET (offset/tamanho) — ruidoso, so para provar a leitura.
# Default: false
# CONSUMER_RANGE_TRACE_LOG=false


# -----------------------------------------------------------------------------
# Legado (nao usar)
# -----------------------------------------------------------------------------
# MERGE_BATCH_SIZE pertencia ao merge_staging.py, removido (substituido pelo
# worker .NET). Mantido apenas como referencia historica.
# MERGE_BATCH_SIZE=10000
